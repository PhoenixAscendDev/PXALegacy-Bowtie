@model IEnumerable<JB2.Bowtie.Web.Models.GraphObjectViewModel>

@{
    ViewBag.Title = "Objects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Objects</h2>

<p>
    @Html.ActionLink("Create New", "CreateObject")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ApplicationID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ElementType)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ParentID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Determiner)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Singular)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Plural)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ApplicationID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ElementType)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ParentID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Determiner)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Singular)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Plural)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Details", "Details", new { id=item.ID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
