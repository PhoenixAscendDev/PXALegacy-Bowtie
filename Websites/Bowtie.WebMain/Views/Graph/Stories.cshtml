@model IEnumerable<JB2.Bowtie.Web.Models.GraphStoryViewModel>

@{
    ViewBag.Title = "Stories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Stories</h2>

<p>
    @Html.ActionLink("Create New", "CreateStory")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.ApplicationID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>  
        <th>
            @Html.DisplayNameFor(model => model.ParentID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ActionID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ObjectID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Past)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PluralPast)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Present)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PluralPresent)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ImperativeTense)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.ApplicationID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
       
       
        <td>
            @Html.DisplayFor(modelItem => item.ParentID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ActionID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ObjectID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Past)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PluralPast)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Present)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PluralPresent)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ImperativeTense)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Details", "Details", new { id=item.ID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
